{
  "name": "scope-bot",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @scope-bot/server --filter @scope-bot/desktop dev",
    "dev:server": "pnpm --filter @scope-bot/server dev",
    "dev:desktop": "pnpm --filter @scope-bot/desktop dev",
    "dev:web": "pnpm --filter @scope-bot/desktop dev:web",
    "start": "pnpm --filter @scope-bot/server start",
    "db:import": "pnpm --filter @scope-bot/server db:import",
    "user:reset-password": "pnpm --filter @scope-bot/server user:reset-password",
    "build": "pnpm --filter @scope-bot/desktop build",
    "build:web": "pnpm --filter @scope-bot/desktop build:web",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
