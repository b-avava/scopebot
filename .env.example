# HTTP port of apps/server
PORT=3000

# Server address used by apps/desktop
SCOPE_BOT_SERVER_URL=http://127.0.0.1:3000

# PostgreSQL 15 or newer. The server creates its tables on start.
DATABASE_URL=postgres://scope_bot:password@127.0.0.1:5432/scope_bot

# For tests. The role must be able to create databases: each test file makes its own and drops it.
TEST_DATABASE_URL=postgres://scope_bot:password@127.0.0.1:5432/postgres

# Encrypts the API keys people add in the app. Changing it makes them unreadable.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SCOPE_BOT_SECRET=

# Language model behind agents. The key stays on the server, never in the desktop app.
#
# Anthropic:
#   LLM_PROVIDER=anthropic
#   LLM_API_KEY=your key
#   LLM_MODEL is optional, the default is claude-opus-5-5
#
# Any OpenAI-style API (OpenAI, OpenRouter, DeepSeek, Groq, Mistral...):
#   LLM_PROVIDER=openai-compatible
#   LLM_API_KEY=your key
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_MODEL=model id from the provider (required)
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# Where apps/server keeps data until PostgreSQL is set up
SCOPE_BOT_DATA_FILE=.data/scope-bot.json

# Instagram (optional). A Meta app with Instagram API with Instagram Login, and a public
# HTTPS address of this server. In the app, set the OAuth redirect to
# PUBLIC_URL/instagram/oauth/callback and the webhook to PUBLIC_URL/instagram/webhook
# with INSTAGRAM_VERIFY_TOKEN, subscribed to "messages". Without all four, Instagram stays off.
PUBLIC_URL=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=

# Voice input uses the ElevenLabs key an owner or admin adds in the app (Providers > Voice input).
# ELEVENLABS_STT_MODEL is optional, the default is scribe_v2.
